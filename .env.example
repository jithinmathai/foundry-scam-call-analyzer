# Foundry resource "Azure AI services" endpoint (Azure portal > resource > Keys and Endpoint)
AI_SERVICES_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# Foundry project endpoint (Foundry portal > project Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Region of the resource, e.g. eastus2 (used only with key auth)
AZURE_REGION=
# Optional. Leave empty to use Microsoft Entra ID (az login). Never commit a real key.
AI_SERVICES_KEY=
# Model deployment used by the scam classifier
DEPLOYMENT=gpt-4.1-mini
